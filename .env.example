# ML Foundations Lab — copy to .env.local and adjust as needed.
# Every var below has a working default; nothing here is required to run
# `npm run dev` with the default SQLite database.

# "sqlite" (default) or "postgres". Postgres requires the optional docker-compose
# service (`docker compose --profile postgres up -d`) or an external database.
ML_DB_DRIVER=sqlite

# SQLite: a file path (relative to the repo root). Postgres: a connection string.
# Postgres example (matches docker-compose.yml's `postgres` service):
#   ML_DATABASE_URL=postgres://ml:ml@localhost:5433/ml_foundations_lab
ML_DATABASE_URL=./data/ml.sqlite3

# HMAC key used to sign the anonymous profile cookie. Change this in any shared
# deployment — anyone with the secret can forge another user's profile cookie.
ML_SESSION_SECRET=dev-only-insecure-secret-change-me

# Fraction (0-1) of quiz questions a user must answer correctly to unlock the
# next section.
ML_QUIZ_PASS_THRESHOLD=0.7
